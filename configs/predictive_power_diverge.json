{
    "dataset": "cifar10",
    "model": "resnet20",
    "model_kwargs": {"norm": "group_norm"},
    "loss_func": "cross_entropy",
    "score_func": "cross_entropy_accuracy",
    "opt": [
            {"name": "schedulet", 
             "lr": [10], 
             "weight_decay": 1e-4,
             "momentum": 0.9, 
             "lr_schedule": "diverge",
             "transition": [0.25, 0.5, 0.75],
             "slope": 75}
        ],
    "batch_size": 128,
    "max_epoch": 50,
    "n_runs": 1
}