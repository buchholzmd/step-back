            {"name": "schedulet", "lr": [0.01, 0.03162, 0.1, 0.3162, 1, 3.162], "weight_decay": 1e-4, "momentum": 0.9, "lr_schedule": "wsd", "warmup": 0.05, "cooldown": 0.05}
